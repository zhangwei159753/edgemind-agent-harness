# DeepSeek text generation
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Brave Search (optional; enables web search and safe page reading)
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# Embedding service (kept independent from text generation)
LOCAL_API_KEY=your_embedding_api_key
LOCAL_BASE_URL=http://localhost:10002/v1
LOCAL_EMBEDDING_MODEL=bge-m3

# Optional local speech recognition (install with: pip install -e ".[audio]")
EDGEMIND_WHISPER_MODEL=small
EDGEMIND_ASR_DEVICE=cpu
EDGEMIND_ASR_COMPUTE_TYPE=int8

# Optional MCP server config path
EDGEMIND_MCP_CONFIG=mcp_servers.json
